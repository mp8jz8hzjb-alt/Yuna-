    Name = "타겟 선택",
    Default = "",
    Options = getPlayerList(),
    Callback = function(val)
        selectedActionTargetName = playerMap[val] or ""
    end
})

TargetTab:AddButton({
    Name = "🔄 플레이어 리스트 갱신",
