-- ==========================================
-- 변수 & 서비스
-- ==========================================
local playerMap = {}
local selectedActionTargetName = ""
local driftRunning = false
local currentLoopId = 0

-- ★ 드리프트 조정용 변수 ★
local driftRadius = 19       -- 너비(반경)
local driftSpeed = 12        -- 회전 속도
local driftHeightOffset = 0  -- 높이
local driftCenterHeight = 30 -- 타겟 중심 높이
local driftGrabCount = 2     -- 잡는 횟수 (드롭 횟수)
local driftGrabInterval = 0.8 -- 다시 잡기 간격
local driftAngle = 0

-- ==========================================
-- 플레이어 리스트 획득
-- ==========================================
local function getPlayerList()
    local names = {}
    playerMap = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player then
            local displayStr = player.DisplayName .. " (@" .. player.Name .. ")"
            table.insert(names, displayStr)
            playerMap[displayStr] = player.Name
        end
    end
    if #names == 0 then table.insert(names, "(None)") end
    return names
end

